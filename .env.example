PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mailcenter
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Cron Settings
# Only used when IMAP_IDLE_ENABLED=false (dev fallback). Not the realtime path.
MAIL_FETCH_INTERVAL=*/5 * * * *

# IMAP IDLE (realtime inbound) — runs in MailCenterWorker only
# Production default is enabled; set explicitly for clarity.
IMAP_IDLE_ENABLED=true
# Backup reconcile interval inside worker listeners (minutes)
IMAP_RECONCILE_INTERVAL_MINUTES=15
# Max exponential backoff for IMAP reconnect (seconds)
IMAP_RECONNECT_MAX_DELAY_SECONDS=300
# Redis lock TTL per account listener (seconds; heartbeat renews)
IMAP_ACCOUNT_LOCK_TTL_SECONDS=45
# How often worker rescans account config (seconds)
IMAP_ACCOUNT_WATCH_INTERVAL_SECONDS=45
# ImapFlow IDLE keepalive (seconds) — must be less than socket timeout
IMAP_MAX_IDLE_TIME_SECONDS=240
IMAP_SOCKET_TIMEOUT_SECONDS=900
# Production + IMAP_IDLE_ENABLED=true requires REDIS_URL (hard fail, no fake idle)

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Backend URL
BACKEND_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Yahoo OAuth
YAHOO_CLIENT_ID=your_yahoo_client_id
YAHOO_CLIENT_SECRET=your_yahoo_client_secret

# Database URL (Railway)
DATABASE_URL=postgresql://postgres:password@host:5432/database

# Redis
# Production + MAIL_QUEUE_ENABLED=true: REDIS_URL is REQUIRED (no localhost HOST fallback).
# Web and worker refuse to start without REDIS_URL in that mode.
# Development (or production with MAIL_QUEUE_ENABLED=false): REDIS_HOST/PORT/PASSWORD fallback is allowed.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Outbound send queue (BullMQ)
# Production: set MAIL_QUEUE_ENABLED=true and a real REDIS_URL — no silent SMTP/SMS/WhatsApp fallback.
# Development: defaults to sync fallback unless MAIL_QUEUE_ENABLED=true.
MAIL_QUEUE_ENABLED=false
MAIL_SYNC_FALLBACK=true
OUTBOUND_MAX_ATTEMPTS=5
OUTBOUND_TENANT_PER_MINUTE=30
OUTBOUND_SENDER_PER_MINUTE=10
OUTBOUND_RECIPIENT_PER_MINUTE=3
OUTBOUND_RATE_LIMIT_DELAY_MS=60000
OUTBOUND_BACKOFF_BASE_MS=5000

# Sentry
SENTRY_DSN=

# AWS S3 / Cloudflare R2
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=mailcenter-attachments
S3_ENDPOINT=

# Logging
LOG_LEVEL=info

# Mail account IMAP/SMTP password encryption (AES-256-GCM, enc:v1: prefix)
# Required in production before creating/updating real mail accounts.
# Provide exactly 32 bytes: 64 hex characters OR base64-encoded 32-byte key.
# Example placeholder (replace before deploy):
MAIL_CREDENTIALS_ENCRYPTION_KEY=your_64_char_hex_or_base64_32_byte_key_here